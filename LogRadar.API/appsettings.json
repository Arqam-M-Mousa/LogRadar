{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=logradar;Username=postgres;Password=postgres;Maximum Pool Size=50;Timeout=30;Command Timeout=30"
  },
  "Ingestion": {
    "ChannelCapacity": 50000,
    "MaxBatchSize": 2000,
    "FlushIntervalMs": 10,
    "WriterConcurrency": 2
  },
  "Retention": {
    "RetentionDays": 14,
    "RunAtUtc": "02:00:00",
    "DeleteBatchSize": 10000
  },
  "AllowedHosts": "*"
}