{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=logradar;Username=postgres;Password=postgres;Maximum Pool Size=50;Timeout=20;Command Timeout=20"
  },
  "Ingestion": {
    "ChannelCapacity": 128,
    "MaxBatchSize": 2000,
    "FlushIntervalMs": 25
  },
  "AggregationCache": {
    "TtlSeconds": 30,
    "RedisEnabled": true,
    "RedisConnection": "redis:6379",
    "RedisKeyPrefix": "logradar:agg:",
    "QueryTimeoutSeconds": 8
  },
  "Retention": {
    "RetentionDays": 14,
    "RunAtUtc": "02:00:00",
    "DeleteBatchSize": 10000
  },
  "AllowedHosts": "*"
}
