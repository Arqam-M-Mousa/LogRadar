{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=logradar;Username=postgres;Password=postgres"
  },
  "Ingestion": {
    "ChannelCapacity": 50000,
    "MaxBatchSize": 2000,
    "FlushIntervalMs": 50,
    "WriterConcurrency": 3
  },
  "Retention": {
    "RetentionDays": 30,
    "RunAtUtc": "02:00:00",
    "DeleteBatchSize": 10000
  },
  "AllowedHosts": "*"
}